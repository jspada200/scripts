#!/bin/sh
# Prints plain-text repo and branch, or nothing if outside a worktree.
# Called by tcsh's precmd alias.
command -v git >/dev/null 2>&1 || exit 0
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
repo=${root##*/}
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=$(git rev-parse --short HEAD 2>/dev/null) || exit 0
printf 'git: %s (%s)' "$repo" "$branch"
